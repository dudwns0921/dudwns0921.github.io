---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { NotFoundPageProps } from '../../contract';

type Props = NotFoundPageProps;

const { site } = Astro.props;
---

<BaseLayout site={site} title={site.title} description={site.description} noindex>
  <slot name="head" slot="head" />
  <main class="h-dvh flex flex-col items-center justify-center gap-4 px-8 text-center">
    <h1 class="text-5xl font-bold">404</h1>
    <p class="text-lg">페이지를 찾을 수 없습니다.</p>
    <a href="/" class="text-blue-600 underline underline-offset-2">이력서로 가기</a>
  </main>
</BaseLayout>
