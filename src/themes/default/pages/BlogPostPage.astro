---
import BlogLayout from '../components/blog/BlogLayout.astro';
import PostMeta from '../components/blog/PostMeta.astro';
import Toc from '../components/blog/Toc.astro';
import CopyCode from '../components/blog/CopyCode.astro';
import Mermaid from '../components/blog/Mermaid.astro';
import Zoom from '../components/blog/Zoom.astro';
import DotComponent from '../components/common/DotComponent';
import type { BlogPostPageProps } from '../../contract';

type Props = BlogPostPageProps;

const { site, post, Content, headings, prev, next, isDraft, hasMermaid } = Astro.props;
---

<BlogLayout
  site={site}
  title={`${post.title} | ${site.blog.title}`}
  description={post.excerpt}
  ogType="article"
  ogImage={post.cover}
  noindex={isDraft}
>
  <article class="flex flex-col gap-6">
    {isDraft && <p class="rounded bg-yellow-100 px-3 py-2 text-sm">초안입니다. 개발 서버에서만 보이고 운영 사이트에는 나가지 않습니다.</p>}
    <header class="flex flex-col gap-3">
      <h1 class="text-3xl font-bold break-keep sm:text-4xl">{post.title}<DotComponent /></h1>
      <PostMeta post={post} />
    </header>
    <Toc headings={headings} />
    <div class="prose">
      <Content />
    </div>
    <p class="border-t border-gray-200 pt-4 text-sm text-gray-500">
      이 글은 <a href="https://creativecommons.org/licenses/by/4.0/deed.ko" target="_blank" rel="noopener noreferrer" class="underline">CC BY 4.0</a> 라이선스를 따릅니다.
    </p>
    {
      (prev || next) && (
        <nav class="grid gap-3 sm:grid-cols-2">
          <div>
            {prev && (
              <a href={prev.url} class="flex flex-col rounded border border-gray-200 p-3 hover:bg-gray-50">
                <span class="text-sm text-gray-500">← 이전 글</span>
                <span class="font-semibold break-keep">{prev.title}</span>
              </a>
            )}
          </div>
          <div>
            {next && (
              <a href={next.url} class="flex flex-col rounded border border-gray-200 p-3 text-right hover:bg-gray-50">
                <span class="text-sm text-gray-500">다음 글 →</span>
                <span class="font-semibold break-keep">{next.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
  <CopyCode />
  {hasMermaid && <Mermaid />}
  <Zoom />
</BlogLayout>
