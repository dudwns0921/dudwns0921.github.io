---
import BlogLayout from '../components/blog/BlogLayout.astro';
import PostList from '../components/blog/PostList.astro';
import CategoryTree from '../components/blog/CategoryTree.astro';
import TagCloud from '../components/blog/TagCloud.astro';
import SearchBox from '../components/blog/SearchBox';
import TitleComponent from '../components/common/TitleComponent';
import type { BlogIndexPageProps } from '../../contract';

type Props = BlogIndexPageProps;

const { site, posts, drafts, tags, categories, searchIndexUrl } = Astro.props;
---

<BlogLayout site={site} title={site.blog.title} description={site.blog.description}>
  <div class="flex flex-col gap-8">
    <SearchBox client:idle indexUrl={searchIndexUrl} />
    {
      drafts.length > 0 && (
        <section>
          <TitleComponent title="초안" size="2xl" />
          <p class="text-sm text-gray-500">개발 서버에서만 보입니다.</p>
          <PostList posts={drafts} />
        </section>
      )
    }
    <section>
      <TitleComponent title="글" size="4xl" />
      <PostList posts={posts} />
    </section>
    <section class="grid gap-8 sm:grid-cols-2">
      <div>
        <TitleComponent title="카테고리" size="2xl" />
        <CategoryTree categories={categories} />
      </div>
      <div>
        <TitleComponent title="태그" size="2xl" />
        <TagCloud tags={tags} />
      </div>
    </section>
  </div>
</BlogLayout>
