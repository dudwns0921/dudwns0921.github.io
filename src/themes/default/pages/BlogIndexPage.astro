---
import BlogLayout from '../components/blog/BlogLayout.astro';
import PostList from '../components/blog/PostList.astro';
import BlogFilter from '../components/blog/BlogFilter.astro';
import TitleComponent from '../components/common/TitleComponent';
import type { BlogIndexPageProps } from '../../contract';

type Props = BlogIndexPageProps;

// categories · searchIndexUrl은 계약에 있지만 이 테마의 첫 화면에서는 쓰지 않는다
// (검색은 목록에 들어 있는 값으로 바로 하고, 카테고리는 글마다 링크로 둔다).
const { site, posts, drafts, tags } = Astro.props;
---

<BlogLayout site={site} title={site.blog.title} description={site.blog.description}>
  <div class="flex flex-col gap-8">
    {
      drafts.length > 0 && (
        <section>
          <TitleComponent title="초안" size="2xl" />
          <p class="text-sm text-gray-500">개발 서버에서만 보입니다.</p>
          <PostList posts={drafts} />
        </section>
      )
    }
    <section class="flex flex-col gap-6">
      <TitleComponent title="글" size="4xl" />
      <BlogFilter tags={tags} total={posts.length} />
      <PostList posts={posts} />
    </section>
  </div>
</BlogLayout>
