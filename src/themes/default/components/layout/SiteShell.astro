---
// 이력서와 블로그의 공통 틀: 머리(SiteHeader) · 본문 · 꼬리. 폭과 좌우 여백을 여기서 한 번만 정한다.
import SiteHeader, { type NavItem } from './SiteHeader.astro';
import type { SiteMeta } from '../../../../content/types';
import { BLOG_URL, GAMES_URL, RESUME_URL } from '../../../../content/urls';

interface Props {
  site: SiteMeta;
  current: 'resume' | 'blog';
  subItems?: NavItem[];
  pdfUrl?: string;
  mainClass?: string;
}

const { site, current, subItems, pdfUrl, mainClass = '' } = Astro.props;
// 로고는 사이트 전체에 하나: 운영 주소의 도메인 이름(elioground.com → elioground)을 쓰고 홈(이력서)으로 간다.
// 사람 이름은 이력서 인사말과 겹쳐서 쓰지 않는다 (본인 요청, 2026-11-11).
const brand = { label: new URL(site.origin).hostname.replace(/^www\./, '').split('.')[0], href: RESUME_URL };
const items: NavItem[] = [
  { label: '이력서', href: RESUME_URL, active: current === 'resume' },
  { label: '블로그', href: BLOG_URL, active: current === 'blog' },
  { label: '게임', href: GAMES_URL },
];
---

<div class="mx-auto flex min-h-dvh max-w-[50rem] flex-col px-4 sm:px-8">
  <SiteHeader brand={brand} items={items} subItems={subItems} pdfUrl={pdfUrl} />
  <main class={`min-w-0 flex-1 ${mainClass}`}>
    <slot />
  </main>
  <footer class="py-8 text-center text-sm text-gray-500">&copy; {new Date().getFullYear()} {site.author}. All rights reserved.</footer>
</div>
