---
// 이력서와 블로그가 함께 쓰는 머리. 넓은 화면(sm 이상)은 로고 + 가로 메뉴,
// 좁은 화면은 로고 + 메뉴 단추이고 단추를 누르면 오른쪽에서 사이드 메뉴가 열린다.
// 머리 전체가 no-pdf라 이력서 PDF에는 나오지 않는다.
import DotComponent from '../common/DotComponent';
import DownloadPDFButton from '../DownloadPDFButton';

export interface NavItem {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  /** 없으면 로고 없이 메뉴만 오른쪽에 둔다 (이력서) */
  brand?: { label: string; href: string };
  items: NavItem[];
  /** 블로그 안에서만 쓰는 메뉴 (태그 · 카테고리 · 아카이브) */
  subItems?: NavItem[];
  /** 있으면 PDF 다운로드 단추를 둔다 (이력서) */
  pdfUrl?: string;
}

const { brand, items, subItems = [], pdfUrl } = Astro.props;
const linkClass = (item: NavItem) =>
  item.active ? 'font-semibold text-gray-900' : 'text-gray-600 hover:text-gray-900 hover:underline';
---

<header class={`no-pdf flex items-center gap-x-6 py-6 ${brand ? 'justify-between' : 'justify-end'}`}>
  {brand && <a href={brand.href} class="text-2xl font-bold break-keep">{brand.label}<DotComponent /></a>}

  <nav class="hidden items-center gap-x-4 sm:flex" aria-label="사이트 메뉴">
    {items.map((item) => <a href={item.href} class={linkClass(item)} aria-current={item.active ? 'page' : undefined}>{item.label}</a>)}
    {subItems.length > 0 && <span class="h-4 w-px bg-gray-300" aria-hidden="true" />}
    {subItems.map((item) => <a href={item.href} class={linkClass(item)}>{item.label}</a>)}
    {pdfUrl && <DownloadPDFButton client:load pdfUrl={pdfUrl} size="sm" />}
  </nav>

  <button
    type="button"
    class="site-drawer-open -mr-2 flex h-10 w-10 items-center justify-center rounded text-gray-700 hover:bg-gray-100 sm:hidden"
    aria-label="메뉴 열기"
    aria-controls="site-drawer"
    aria-expanded="false"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</header>

<div id="site-drawer" class="no-pdf fixed inset-0 z-50 sm:hidden" hidden>
  <div class="site-drawer-close absolute inset-0 bg-black/40" aria-hidden="true"></div>
  <aside
    class="absolute inset-y-0 right-0 flex w-72 max-w-[85vw] flex-col gap-6 overflow-y-auto bg-white p-6 shadow-xl"
    role="dialog"
    aria-modal="true"
    aria-label="사이트 메뉴"
  >
    <div class="flex items-center justify-between">
      <span class="text-xl font-bold">메뉴<DotComponent /></span>
      <button type="button" class="site-drawer-close -mr-2 flex h-10 w-10 items-center justify-center rounded text-gray-700 hover:bg-gray-100" aria-label="메뉴 닫기">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <nav class="flex flex-col gap-1 text-lg">
      {items.map((item) => (
        <a href={item.href} class={`rounded px-2 py-2 hover:bg-gray-100 ${item.active ? 'font-semibold text-gray-900' : 'text-gray-700'}`} aria-current={item.active ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    {subItems.length > 0 && (
      <nav class="flex flex-col gap-1 border-t border-gray-200 pt-4">
        <span class="px-2 pb-1 text-sm text-gray-500">블로그</span>
        {subItems.map((item) => (
          <a href={item.href} class={`rounded px-2 py-2 hover:bg-gray-100 ${item.active ? 'font-semibold text-gray-900' : 'text-gray-700'}`}>{item.label}</a>
        ))}
      </nav>
    )}
    {pdfUrl && (
      <div class="border-t border-gray-200 pt-4">
        <DownloadPDFButton client:load pdfUrl={pdfUrl} block />
      </div>
    )}
  </aside>
</div>

<script>
  const drawer = document.getElementById('site-drawer');
  const opener = document.querySelector<HTMLButtonElement>('.site-drawer-open');
  if (drawer && opener) {
    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      opener.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) drawer.querySelector<HTMLElement>('nav a')?.focus();
      else opener.focus();
    };
    opener.addEventListener('click', () => setOpen(true));
    drawer.querySelectorAll('.site-drawer-close').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    drawer.querySelectorAll('a').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) setOpen(false);
    });
    // 넓은 화면으로 돌아가면 닫는다.
    matchMedia('(min-width: 640px)').addEventListener('change', (e) => e.matches && !drawer.hidden && setOpen(false));
  }
</script>
