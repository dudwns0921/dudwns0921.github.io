---
// 태그 알약 (velog 모양: 회색 바탕 · 청록 글자). 누르면 그 태그의 글 목록으로 간다.
interface Props {
  tags: { name: string; url: string }[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <a href={tag.url} class="rounded-full bg-gray-100 px-3 py-1 text-sm font-semibold text-teal-700 hover:bg-gray-200">
          {tag.name}
        </a>
      ))}
    </div>
  )
}
