---
import type { CategoryNode } from '../../../../content/types';

interface Props {
  categories: CategoryNode[];
}

const { categories } = Astro.props;
---

<ul class="flex flex-col gap-1">
  {
    categories.map((node) => (
      <li>
        <a href={node.url} class="hover:underline">
          {node.name}
        </a>
        <span class="text-sm text-gray-500"> {node.count}</span>
        {node.children.length > 0 && (
          <div class="pl-4">
            <Astro.self categories={node.children} />
          </div>
        )}
      </li>
    ))
  }
</ul>
