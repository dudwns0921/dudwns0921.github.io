---
// 글 본문의 <pre class="mermaid">(```mermaid 블록, src/content/markdown/remark-mermaid.ts가 만든다)를 브라우저에서 그림으로 그린다.
// BlogPostPage가 mermaid 블록이 있는 글에서만 이 컴포넌트를 넣으므로, 다른 페이지에는 스크립트가 붙지 않는다.
// mermaid 라이브러리는 따로 나뉜 파일로 번들되고 여기서만 불러온다.
// 색은 코드 블록처럼 시스템 다크 모드를 따른다 (prefers-color-scheme). 모드가 바뀌면 다시 그린다.
---
<script>
  const render = async () => {
    const blocks = [...document.querySelectorAll<HTMLElement>('.prose pre.mermaid')];
    if (blocks.length === 0) return;
    // 그리면 안의 글자가 SVG로 바뀌므로 원문을 먼저 남겨 둔다.
    for (const block of blocks) block.dataset.source ??= block.textContent ?? '';
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const { default: mermaid } = await import('mermaid');
    const draw = async () => {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: media.matches ? 'dark' : 'default',
        fontFamily: 'inherit',
      });
      for (const block of blocks) {
        block.removeAttribute('data-processed');
        block.textContent = block.dataset.source ?? '';
      }
      await mermaid.run({ nodes: blocks, suppressErrors: true });
    };
    await draw();
    media.addEventListener('change', () => void draw());
  };
  void render();
</script>
