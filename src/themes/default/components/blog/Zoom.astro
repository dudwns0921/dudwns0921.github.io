---
// 글 본문의 이미지와 mermaid 그림을 누르면 화면 가득 크게 보여 준다 (휴대폰에서 작은 그림을 두 손가락으로 키워 보도록).
// 여기 스크립트는 누를 수 있는 것에 표시만 하는 작은 것이고, 확대 화면(zoom-viewer.ts)은 처음 누를 때 불러온다.
// 링크로 감싼 이미지(<a><img></a>)는 링크가 먼저라 빼고, mermaid는 SVG로 그려진 뒤에만 연다.
---
<script>
  const mark = (el: HTMLElement, label: string) => {
    el.dataset.zoom = '';
    el.tabIndex = 0;
    el.setAttribute('role', 'button');
    el.setAttribute('aria-label', label);
  };
  let count = 0;
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
    if (img.closest('a')) return;
    mark(img, img.alt ? `${img.alt} — 크게 보기` : '이미지 크게 보기');
    count++;
  });
  document.querySelectorAll<HTMLElement>('.prose pre.mermaid').forEach((pre) => {
    mark(pre, '그림 크게 보기');
    count++;
  });

  if (count > 0) {
    const open = async (el: HTMLElement) => {
      if (el.matches('pre.mermaid') && !el.querySelector('svg')) return;
      const { openZoom } = await import('./zoom-viewer');
      openZoom(el);
    };
    const target = (event: Event) => (event.target as Element | null)?.closest<HTMLElement>('.prose [data-zoom]');
    document.addEventListener('click', (event) => {
      const el = target(event);
      if (el) void open(el);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const el = target(event);
      if (!el || el !== event.target) return;
      event.preventDefault();
      void open(el);
    });
  }
</script>
