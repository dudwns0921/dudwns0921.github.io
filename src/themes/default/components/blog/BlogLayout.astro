---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteShell from '../layout/SiteShell.astro';
import type { SiteMeta } from '../../../../content/types';
import '../../styles/prose.css';

interface Props {
  site: SiteMeta;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
}

const { site, title, description, ogType, ogImage, noindex } = Astro.props;
---

<BaseLayout site={site} title={title} description={description} ogType={ogType} ogImage={ogImage} noindex={noindex}>
  <slot name="head" slot="head" />
  <SiteShell site={site} current="blog">
    <slot />
  </SiteShell>
</BaseLayout>
