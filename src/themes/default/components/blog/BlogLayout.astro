---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteShell from '../layout/SiteShell.astro';
import type { SiteMeta } from '../../../../content/types';
import { archiveUrl, categoriesIndexUrl, tagsIndexUrl } from '../../../../content/urls';
import '../../styles/prose.css';

interface Props {
  site: SiteMeta;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
}

const { site, title, description, ogType, ogImage, noindex } = Astro.props;
const subItems = [
  { label: '태그', href: tagsIndexUrl() },
  { label: '카테고리', href: categoriesIndexUrl() },
  { label: '아카이브', href: archiveUrl() },
];
---

<BaseLayout site={site} title={title} description={description} ogType={ogType} ogImage={ogImage} noindex={noindex}>
  <slot name="head" slot="head" />
  <SiteShell site={site} current="blog" subItems={subItems}>
    <slot />
  </SiteShell>
</BaseLayout>
