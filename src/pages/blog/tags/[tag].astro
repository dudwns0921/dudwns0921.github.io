---
import type { GetStaticPaths } from 'astro';
import theme from '@theme';
import { getPosts, getTags, postsWithTag } from '../../../content/blog';
import { getSite } from '../../../content/site';

// /blog/tags/<slug>/ — 슬러그는 Hexo와 같다 (Lv.1 → Lv-1).
export const getStaticPaths = (async () => {
  const tags = await getTags();
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { name: tag.name } }));
}) satisfies GetStaticPaths;

const { BlogListPage } = theme;
const { tag } = Astro.params;
const { name } = Astro.props;
const [site, posts] = await Promise.all([getSite(), getPosts()]);
---

<BlogListPage site={site} kind="tag" title={name} posts={postsWithTag(posts, tag!)} />
