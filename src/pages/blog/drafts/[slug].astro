---
import type { GetStaticPaths } from 'astro';
import theme from '@theme';
import { getDrafts, getPostEntry, renderPost } from '../../../content/blog';
import { getSite } from '../../../content/site';

// 초안은 개발 서버에서만 보인다. 운영 빌드에서는 주소를 하나도 만들지 않는다.
export const getStaticPaths = (async () => {
  if (import.meta.env.PROD) return [];
  return (await getDrafts()).map((draft) => ({ params: { slug: draft.slug } }));
}) satisfies GetStaticPaths;

const { BlogPostPage } = theme;
const { slug } = Astro.params;
const [site, { summary, entry }] = await Promise.all([getSite(), getPostEntry(slug!, true)]);
const { Content, headings, remarkPluginFrontmatter } = await renderPost(entry);
---

<BlogPostPage site={site} post={summary} Content={Content} headings={headings} isDraft={true} hasMermaid={remarkPluginFrontmatter.hasMermaid === true} />
